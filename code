// AI Blind Assist Robot - Class 7
// Obstacle Detection + Voice Alert + Road Crossing Assistance

#define trigPin 9
#define echoPin 10
#define irPin 8
#define buzzer 6
#define vibration 7

// Motor pins
#define m1 2
#define m2 3
#define m3 4
#define m4 5

long duration;
int distance;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(irPin, INPUT);

  pinMode(buzzer, OUTPUT);
  pinMode(vibration, OUTPUT);

  pinMode(m1, OUTPUT);
  pinMode(m2, OUTPUT);
  pinMode(m3, OUTPUT);
  pinMode(m4, OUTPUT);

  Serial.begin(9600);   // For testing
}

void loop() {

  // Ultrasonic Sensor Code
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH);
  distance = duration * 0.034 / 2;

  Serial.print("Distance: ");
  Serial.println(distance);

  // OBSTACLE DETECTED
  if (distance < 50) {
    stopRobot();
    alertWarning();
    // Voice module plays "Obstacle Ahead – Stop"
  }

  // NO OBSTACLE
  else {
    moveForward();
    digitalWrite(buzzer, LOW);
    digitalWrite(vibration, LOW);
  }

  // ROAD CROSSING DETECTION
  int road = digitalRead(irPin);
  if (road == LOW) {
    stopRobot();
    digitalWrite(buzzer, HIGH);
    delay(500);
    digitalWrite(buzzer, LOW);
    // Voice module plays "Road crossing detected"
  }

  delay(100);
}

// FUNCTIONS

void moveForward() {
  digitalWrite(m1, HIGH);
  digitalWrite(m2, LOW);
  digitalWrite(m3, HIGH);
  digitalWrite(m4, LOW);
}

void stopRobot() {
  digitalWrite(m1, LOW);
  digitalWrite(m2, LOW);
  digitalWrite(m3, LOW);
  digitalWrite(m4, LOW);
}

void alertWarning() {
  digitalWrite(buzzer, HIGH);
  digitalWrite(vibration, HIGH);
  delay(300);
  digitalWrite(buzzer, LOW);
  digitalWrite(vibration, LOW);
}
